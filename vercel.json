{
  "rewrites": [
    {
      "source": "/v/:id/img.jpg",
      "destination": "https://api.qurapp.com/v/:id/img"
    },
    {
      "source": "/v/:id/img",
      "destination": "https://api.qurapp.com/v/:id/img"
    },
    {
      "source": "/v/:id",
      "destination": "https://api.qurapp.com/v/:id"
    },
    {
      "source": "/products/hisnul-muslim",
      "has": [
        {
          "type": "header",
          "key": "User-Agent",
          "value": "(?i).*(telegram|facebook|whatsapp|twitter|discord|bot|crawl|metadata|screenshot|slack).*"
        }
      ],
      "destination": "/hisnul-muslim-bot.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}